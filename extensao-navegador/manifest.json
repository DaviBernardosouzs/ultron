{
  "manifest_version": 3,
  "name": "Ultron in Chrome",
  "version": "1.0.0",
  "description": "Liga o navegador ao Ultron: conversar, pesquisar, depurar e agir nas páginas.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "scripting", "debugger", "sidePanel", "storage", "alarms", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {"service_worker": "fundo.js", "type": "module"},
  "side_panel": {"default_path": "painel.html"},
  "options_page": "opcoes.html",
  "action": {"default_title": "Ultron", "default_icon": {"16": "icones/16.png", "32": "icones/32.png"}},
  "icons": {"16": "icones/16.png", "48": "icones/48.png", "128": "icones/128.png"},
  "commands": {
    "_execute_action": {"suggested_key": {"default": "Alt+U"}, "description": "Abrir o Ultron"}
  }
}
